PORT=5000
NODE_ENV=development

# Local Postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public

# Render — if Internal URL fails with P1001, use External URL on the WEB service:
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.REGION-postgres.render.com/DB_NAME?sslmode=require
